FLASK_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=filmdex

FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json

CLIENT_URL=*

# ─── ngrok (public tunnel for the API) ─────────────────────────
# Set USE_NGROK=true to expose the local Flask server at a public
# https URL on every start. Useful when running the mobile app on
# a phone that isn't on the same WiFi as the API host, or for sharing
# a demo with teammates.
USE_NGROK=false
NGROK_AUTH_TOKEN=
